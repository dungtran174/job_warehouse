# Copy to an ignored local file; use absolute host paths.
HISTORY_PARQUET_PATH=/absolute/path/to/history_data.parquet
WAREHOUSE_REPORT_ROOT=/absolute/path/outside/repository/warehouse_reports
WAREHOUSE_DB_PASSWORD_FILE=/absolute/path/to/local/db_password
WAREHOUSE_DB_NAME=job_warehouse
WAREHOUSE_DB_USER=warehouse
WAREHOUSE_DB_PORT=55432
# Set to the UID/GID of the user who owns reports and the password file.
WAREHOUSE_UID=1000
WAREHOUSE_GID=1000
